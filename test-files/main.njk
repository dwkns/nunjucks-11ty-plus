---
title: My Eleventy Site
layout: base.njk
tags:
  - blog
  - featured
permalink: /posts/{{ title | slugify }}/
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }} | {{ site.name }}</title>
    <link rel="stylesheet" href="/css/style.css" />

    <style>
:root {
  --primary: #0078d4;
  --bg: #1f1f1f;
}
body {
  font-family: system-ui, sans-serif;
  background: var(--bg);
  color: #ccc;
  margin: 0;
  padding: 2rem;
}
.card {
  border: 1px solid #333;
  border-radius: 8px;
  padding: 1.5rem;
}
.highlight {
  color: var(--primary);
  font-weight: bold;
}

</style>
  </head>

  <body>
    {# ============================================
Navigation - demonstrates comments, blocks,
includes, and extends
============================================ #}

    {% block header %}
      <header>
        <nav>
          <a href="/">{{ site.name }}</a>
          {% for item in navigation %}
            <a
              href="{{ item.url }}"
              class="{% if item.url == page.url %}active{% endif %}"
            >
              {{ item.title }}
            </a>
          {% endfor %}
        </nav>
      </header>
    {% endblock %}

    {# Main content area #}
    <main>
      <h1>{{ title }}</h1>

      {# --- Macros --- #}
      {% macro field(name, value='', type='text', required=false) %}
        <div class="field">
          <label for="{{ name }}">{{ name | capitalize }}</label>
          <input
            type="{{ type }}"
            id="{{ name }}"
            name="{{ name }}"
            value="{{ value }}"
            {% if required %}
              required
            {% endif %}
          />
        </div>
      {% endmacro %}

      {% macro card(heading, body, level=2) %}
        <div class="card">
          <h{{ level }}>{{ heading }}</h{{ level }}>
          <p>{{ body | truncate(120) }}</p>
        </div>
      {% endmacro %}

      {# --- Using macros --- #}
      <form>
        {{ field('username', type='text', required=true) }}
        {{ field('email', type='email', required=true) }}
        {{ field('password', value='', type='password') }}
      </form>

      {# --- Conditionals --- #}
      {% if user.isAdmin %}
        <p class="highlight">Welcome back, admin {{ user.name }}!</p>
      {% elif user.isLoggedIn %}
        <p>
          Hello, {{ user.name }}. You have {{ user.messages | length }}
          messages.
        </p>
      {% else %}
        <p>Please <a href="/login">sign in</a>.</p>
      {% endif %}

      {# --- Loops with filters --- #}
      <h2>Blog Posts ({{ posts | length }} total)</h2>
      <ul>
        {% for post in posts | sort(attribute='date') | reverse %}
          <li>
            <a href="{{ post.url }}">{{ post.title | title }}</a>
            <span>{{ post.date }}</span>
            <span>{{ post.tags | join(', ') }}</span>
          </li>
        {% endfor %}
      </ul>

      {# --- Set variables and objects --- #}
      {% set maxItems = 5 %}
      {%
        set config = {
        theme: "dark",
        columns: 3,
        showDates: true
        }
      %}

      {% set colors = ['red', 'green', 'blue', 'orange', 'purple'] %}

      {# --- Whitespace control --- #}
      <p>
        Tags:
        {%- for tag in tags -%}
          {%- if not loop.first %},
          {% endif -%}
          {{ tag | lower }}
        {%- endfor -%}
      </p>

      {# --- Iteration with destructuring --- #}
      {% for fruit, color in fruits %}
        <span style="color: {{ color }}">{{ fruit | capitalize }}</span>
      {% endfor %}

      {# --- Filters chained --- #}
      <p>{{ description | striptags | truncate(200) | safe }}</p>
      <p>{{ longText | replace("foo", "bar") | trim | upper }}</p>
      <p>{{ items | reject("odd") | join(" - ") }}</p>
      <p>{{ amount | round(2) | string }}</p>

      {# --- Numbers and arithmetic --- #}
      {% set total = 42 %}
      {% set price = 19.99 %}
      {% set discount = -5 %}
      <p>Items: {{ total }}, Price: ${{ price }}, Savings: ${{ discount }}</p>

      {# --- Block inheritance with super --- #}
      {% block sidebar %}
        {{ super() }}
        <aside>
          <h3>Extra sidebar content</h3>
        </aside>
      {% endblock %}

      {# --- Import and include --- #}
      {% import "macros.njk" as helpers %}
      {% include "partials/footer.njk" %}

      {# --- With block --- #}
      {% with subtitle = "Featured Section" %}
        <h2>{{ subtitle }}</h2>
      {% endwith %}

      {# --- Raw block (no processing) --- #}
      {% raw %}
        <p>
          This shows literal {{ tags }} and {% blocks %} without processing.
        </p>
      {% endraw %}

      {# --- Async iteration --- #}
      <ul>
        {% asyncAll item in asyncItems %}
        <li>{{ item.id }}: {{ item.name | escape }}</li>
        {% endall %}
      </ul>

      {# --- Complex nesting: objects in function calls --- #}
      {{
        govukButton({
        text: "Submit form",
        classes: "govuk-button--primary",
        attributes: {
        "data-module": "govuk-button"
        }
        })
      }}

      {# --- Groupby and dictsort filters --- #}
      {% for type, items in products | groupby("category") %}
        <h3>{{ type | title }}</h3>
        <ul>
          {% for item in items %}
            <li>{{ item.name }} - ${{ item.price }}</li>
          {% endfor %}
        </ul>
      {% endfor %}

      {% for key, val in metadata | dictsort %}
        <dt>{{ key }}</dt>
        <dd>{{ val }}</dd>
      {% endfor %}
    </main>

    <script>
    document.addEventListener("DOMContentLoaded", () => {
  const cards = document.querySelectorAll(".card");
  cards.forEach((card, index) => {
    card.style.animationDelay = `${index * 0.1}s`;
    card.classList.add("fade-in");
  });

  async function loadPosts() {
    const response = await fetch("/api/posts.json");
    const data = await response.json();
    return data.posts;
  }

  loadPosts().then(posts => {
    console.log(`Loaded ${posts.length} posts`);
  });
});
    </script>

    {% block footer %}
      <footer>
        <p>
          &copy; {{ "now" | date("Y") }} {{ site.name }}. Built with
          <a href="https://www.11ty.dev">Eleventy</a>.
        </p>
      </footer>
    {% endblock %}
  </body>
</html>
