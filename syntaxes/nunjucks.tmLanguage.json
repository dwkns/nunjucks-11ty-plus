{
  "name": "nunjucks",
  "scopeName": "text.html.nunjucks",
  "patterns": [
    {
      "include": "#nunjucks-tags"
    },
    {
      "include": "#front-matter"
    },
    {
      "include": "#extends"
    },
    {
      "include": "#block_comments"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#block_helper"
    },
    {
      "include": "#end_block"
    },
    {
      "include": "#else_token"
    },
    {
      "include": "#inline-and-nested-tags"
    },
    {
      "include": "#inline_script"
    },
    {
      "include": "#html_tags"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "inline-and-nested-tags": {
      "patterns": [
        {
          "begin": "(\\{\\{~?\\{*(>|!<)*)\\s*(@?[-a-zA-Z0-9$_\\./]+)*",
          "end": "(~?\\}\\}\\}*)",
          "name": "meta.function.inline.other.nunjucks",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.nunjucks"
            },
            "3": {
              "name": "variable.parameter.nunjucks"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.nunjucks"
            }
          },
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#handlebars_attribute"
            },
            {
              "include": "#function-args"
            },
            {
              "include": "#object"
            }
          ]
        },
        {
          "begin": "(\\{\\%~?\\{*(>|!<)*)\\s*(@?[-a-zA-Z0-9$_\\./]+)*",
          "end": "(~?\\%\\}\\}*)",
          "name": "meta.function.inline.other.nunjucks",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.nunjucks"
            },
            "3": {
              "name": "variable.parameter.nunjucks"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.nunjucks"
            }
          },
          "patterns": [
            {
              "include": "#string"
            },
            {
              "include": "#handlebars_attribute"
            },
            {
              "include": "#function-args"
            },
            {
              "include": "#object"
            }
          ]
        }
      ]
    },
    "nunjucks-tags": {
      "patterns": [
        {
          "comment": "Captures everyting between {%  %} tags",
          "name": "meta.tag.nunjucks",
          "begin": "({%)(-)?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.nunjucks"
            },
            "2": {
              "name": "keyword.other.whitespace.nunjucks"
            }
          },
          "end": "(-)?(%})",
          "endCaptures": {
            "1": {
              "name": "keyword.other.whitespace.nunjucks"
            },
            "2": {
              "name": "punctuation.definition.tag.end.nunjucks"
            }
          },
          "patterns": [
            {
              "match": "\\b(for|in|endfor|if|endif|else|elif|block|endblock|extends|include|set|macro|endmacro|call|endcall|import|with|endwith|filter|endfilter|raw|endraw|asyncEach|endasyncEach|asyncAll|endasyncAll|verbatim|endverbatim|super)\\b",
              "name": "keyword.control.nunjucks"
            },
            {
              "match": "\\|\\s*(capitalize|default|length|lower|upper|sort|join|replace|trim|reverse|first|last|escape|e|batch|round|abs|float|int|title|truncate|safe|dictsort|groupby|striptags|indent|nl2br|reject|rejectattr|select|selectattr|sum|urlencode|string|dump|list|slice|random|center|forceescape|wordcount|urlize)\\b",
              "name": "entity.name.function.filter.nunjucks"
            },
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
              "name": "entity.name.function.nunjucks"
            },
            {
              "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
              "name": "constant.numeric.nunjucks"
            },
            {
              "comment": "variable names (support dotted properties)",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)\\b",
              "name": "variable.nunjucks"
            }
          ]
        },
        {
          "name": "meta.tag.nunjucks",
          "begin": "({{)(-)?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.nunjucks"
            },
            "2": {
              "name": "keyword.other.whitespace.nunjucks"
            }
          },
          "end": "(-)?(}})",
          "endCaptures": {
            "1": {
              "name": "keyword.other.whitespace.nunjucks"
            },
            "2": {
              "name": "punctuation.definition.tag.end.nunjucks"
            }
          },
          "patterns": [
            {
              "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
              "name": "constant.numeric.nunjucks"
            },
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
              "name": "entity.name.function.nunjucks"
            },
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)\\b",
              "name": "variable.nunjucks"
            },
            {
              "match": "\\|\\s*(capitalize|default|length|lower|upper|sort|join|replace|trim|reverse|first|last|escape|e|batch|round|abs|float|int|title|truncate|safe|dictsort|groupby|striptags|indent|nl2br|reject|rejectattr|select|selectattr|sum|urlencode|string|dump|list|slice|random|center|forceescape|wordcount|urlize)\\b",
              "name": "entity.name.function.filter.nunjucks"
            },
            {
              "match": "\\(",
              "name": "punctuation.section.group.begin.nunjucks"
            },
            {
              "match": "\\)",
              "name": "punctuation.section.group.end.nunjucks"
            }
          ]
        }
      ]
    },
    "front-matter": {
      "patterns": [
        {
          "comment": "front-matter-yaml",
          "name": "meta.embedded.block.yaml.frontmatter",
          "begin": "^---\\s*$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.tag.begin.frontmatter"
            }
          },
          "end": "^---\\s*$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.end.frontmatter"
            }
          },
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        },
        {
          "comment": "front-matter-js",
          "contentName": "source.js",
          "name": "meta.embedded.block.js.frontmatter",
          "begin": "^---js\\s*$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.tag.begin.frontmatter"
            }
          },
          "end": "^---\\s*$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.end.frontmatter"
            }
          },
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "comment": "front-matter-json",
          "contentName": "source.json",
          "name": "meta.embedded.block.json.frontmatter",
          "begin": "^---json\\s*$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.tag.begin.frontmatter"
            }
          },
          "end": "^---\\s*$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.tag.end.frontmatter"
            }
          },
          "patterns": [
            {
              "include": "source.json"
            }
          ]
        }
      ]
    },
    "html_tags": {
      "patterns": [
        {
          "begin": "(<)([a-zA-Z0-9:-]+)(?=[^>]*></\\2>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.html"
            }
          },
          "end": "(>(<)/)(\\2)(>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "meta.scope.between-tag-pair.html"
            },
            "3": {
              "name": "entity.name.tag.html"
            },
            "4": {
              "name": "punctuation.definition.tag.html"
            }
          },
          "name": "meta.tag.any.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "begin": "(<\\?)(xml)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.xml.html"
            }
          },
          "end": "(\\?>)",
          "name": "meta.tag.preprocessor.xml.html",
          "patterns": [
            {
              "include": "#tag_generic_attribute"
            },
            {
              "include": "#string"
            }
          ]
        },
        {
          "begin": "<!--",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          },
          "end": "--\\s*>",
          "name": "comment.block.html",
          "patterns": [
            {
              "match": "--",
              "name": "invalid.illegal.bad-comments-or-CDATA.html"
            }
          ]
        },
        {
          "begin": "<!",
          "captures": {
            "0": {
              "name": "punctuation.definition.tag.html"
            }
          },
          "end": ">",
          "name": "meta.tag.sgml.html",
          "patterns": [
            {
              "begin": "(DOCTYPE|doctype)",
              "captures": {
                "1": {
                  "name": "entity.name.tag.doctype.html"
                }
              },
              "end": "(?=>)",
              "name": "meta.tag.sgml.doctype.html",
              "patterns": [
                {
                  "match": "\"[^\">]*\"",
                  "name": "string.quoted.double.doctype.identifiers-and-DTDs.html"
                }
              ]
            },
            {
              "begin": "\\[CDATA\\[",
              "end": "]](?=>)",
              "name": "constant.other.inline-data.html"
            },
            {
              "match": "(\\s*)(?!--|>)\\S(\\s*)",
              "name": "invalid.illegal.bad-comments-or-CDATA.html"
            }
          ]
        },
        {
          "begin": "(?:^\\s+)?(<)((?i:style))\\b(?![^>]*/>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.style.html"
            },
            "3": {
              "name": "punctuation.definition.tag.html"
            }
          },
          "end": "(</)((?i:style))(>)(?:\\s*\\n)?",
          "name": "meta.embedded.block.css",
          "patterns": [
            {
              "include": "#tag-stuff"
            },
            {
              "begin": "(>)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.tag.html"
                }
              },
              "end": "(?=</(?i:style))",
              "patterns": [
                {
                  "include": "source.css"
                }
              ]
            }
          ]
        },
        {
          "begin": "(?:^\\s+)?(<)((?i:script))\\b(?![^>]*/>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.script.html"
            }
          },
          "end": "(?<=</(script|SCRIPT))(>)(?:\\s*\\n)?",
          "endCaptures": {
            "2": {
              "name": "punctuation.definition.tag.html"
            }
          },
          "name": "meta.embedded.block.javascript",
          "patterns": [
            {
              "include": "#tag-stuff"
            },
            {
              "begin": "(?<!</(?:script|SCRIPT))(>)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.tag.html"
                },
                "2": {
                  "name": "entity.name.tag.script.html"
                }
              },
              "end": "(</)((?i:script))",
              "patterns": [
                {
                  "captures": {
                    "1": {
                      "name": "punctuation.definition.comment.js"
                    }
                  },
                  "match": "(//).*?((?=</script)|$\\n?)",
                  "name": "comment.line.double-slash.js"
                },
                {
                  "begin": "/\\*",
                  "captures": {
                    "0": {
                      "name": "punctuation.definition.comment.js"
                    }
                  },
                  "end": "\\*/|(?=</script)",
                  "name": "comment.block.js"
                },
                {
                  "include": "source.js"
                }
              ]
            }
          ]
        },
        {
          "begin": "(</?)((?i:body|head|html)\\b)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.structure.any.html"
            }
          },
          "end": "(>)",
          "name": "meta.tag.structure.any.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "begin": "(</?)((?i:address|blockquote|dd|div|header|section|footer|aside|nav|dl|dt|fieldset|form|frame|frameset|h1|h2|h3|h4|h5|h6|iframe|noframes|object|ol|p|ul|applet|center|dir|hr|menu|pre)\\b)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.block.any.html"
            }
          },
          "end": "(>)",
          "name": "meta.tag.block.any.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "begin": "(</?)((?i:a|abbr|acronym|area|b|base|basefont|bdo|big|br|button|caption|cite|code|col|colgroup|del|dfn|em|font|head|html|i|img|input|ins|isindex|kbd|label|legend|li|link|map|meta|noscript|optgroup|option|param|q|s|samp|script|select|small|span|strike|strong|style|sub|sup|table|tbody|td|textarea|tfoot|th|thead|title|tr|tt|u|var)\\b)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.inline.any.html"
            }
          },
          "end": "((?: ?/)?>)",
          "name": "meta.tag.inline.any.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "begin": "(</?)([a-zA-Z0-9:-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.other.html"
            }
          },
          "end": "(>)",
          "name": "meta.tag.other.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "begin": "(</?)([a-zA-Z0-9{}:-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.html"
            },
            "2": {
              "name": "entity.name.tag.tokenised.html"
            }
          },
          "end": "(>)",
          "name": "meta.tag.tokenised.html",
          "patterns": [
            {
              "include": "#tag-stuff"
            }
          ]
        },
        {
          "include": "#entities"
        },
        {
          "match": "<>",
          "name": "invalid.illegal.incomplete.html"
        },
        {
          "match": "<",
          "name": "invalid.illegal.bad-angle-bracket.html"
        }
      ]
    },
    "entities": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.html"
            },
            "3": {
              "name": "punctuation.definition.entity.html"
            }
          },
          "name": "constant.character.entity.html",
          "match": "(&)([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+)(;)"
        },
        {
          "name": "invalid.illegal.bad-ampersand.html",
          "match": "&"
        }
      ]
    },
    "end_block": {
      "begin": "(\\{\\{)(~?/)([a-zA-Z0-9/_\\.-]+)\\s*",
      "end": "(~?\\}\\})",
      "name": "meta.tag.block.end.nunjucks",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.nunjucks"
        }
      },
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.nunjucks"
        },
        "2": {
          "name": "keyword.other.whitespace.nunjucks"
        },
        "3": {
          "name": "keyword.control.nunjucks"
        }
      },
      "patterns": []
    },
    "comments": {
      "patterns": [
        {
          "patterns": [
            {
              "name": "keyword.annotation.nunjucks",
              "match": "@\\w*"
            },
            {
              "include": "#comments"
            }
          ],
          "begin": "\\{#",
          "end": "#\\}",
          "name": "comment.block.nunjucks"
        },
        {
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          },
          "begin": "<!--",
          "end": "-{2,3}\\s*>",
          "name": "comment.block.html",
          "patterns": [
            {
              "name": "invalid.illegal.bad-comments-or-CDATA.html",
              "match": "--"
            }
          ]
        }
      ]
    },
    "block_comments": {
      "patterns": [
        {
          "patterns": [
            {
              "name": "keyword.annotation.nunjucks",
              "match": "@\\w*"
            },
            {
              "include": "#comments"
            }
          ],
          "begin": "\\{\\{!--",
          "end": "--\\}\\}",
          "name": "comment.block.nunjucks"
        },
        {
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.html"
            }
          },
          "begin": "<!--",
          "end": "-{2,3}\\s*>",
          "name": "comment.block.html",
          "patterns": [
            {
              "name": "invalid.illegal.bad-comments-or-CDATA.html",
              "match": "--"
            }
          ]
        }
      ]
    },
    "block_helper": {
      "begin": "(\\{\\{)(~?\\#)([-a-zA-Z0-9_\\./>]+)\\s?(@?[-a-zA-Z0-9_\\./]+)*\\s?(@?[-a-zA-Z0-9_\\./]+)*\\s?(@?[-a-zA-Z0-9_\\./]+)*",
      "end": "(~?\\}\\})",
      "name": "meta.tag.block.start.nunjucks",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.nunjucks"
        }
      },
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.nunjucks"
        },
        "2": {
          "name": "keyword.other.whitespace.nunjucks"
        },
        "3": {
          "name": "keyword.control.nunjucks"
        },
        "4": {
          "name": "variable.parameter.nunjucks"
        },
        "5": {
          "name": "punctuation.definition.tag.nunjucks"
        },
        "6": {
          "name": "variable.parameter.nunjucks"
        },
        "7": {
          "name": "punctuation.definition.tag.nunjucks"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#handlebars_attribute"
        }
      ]
    },
    "string-single-quoted": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.nunjucks",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.html"
        }
      },
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.html"
        }
      },
      "patterns": [
        {
          "include": "#escaped-single-quote"
        },
        {
          "include": "#block_comments"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#block_helper"
        },
        {
          "include": "#else_token"
        },
        {
          "include": "#end_block"
        },
        {
          "include": "#inline-and-nested-tags"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "include": "#string-single-quoted"
        },
        {
          "include": "#string-double-quoted"
        }
      ]
    },
    "escaped-single-quote": {
      "name": "constant.character.escape.js",
      "match": "\\\\'"
    },
    "escaped-double-quote": {
      "name": "constant.character.escape.js",
      "match": "\\\\\""
    },
    "handlebars_attribute_name": {
      "begin": "\\b([-a-zA-Z0-9_\\.]+)\\b=",
      "captures": {
        "1": {
          "name": "variable.parameter.nunjucks"
        }
      },
      "end": "(?='|\"|)",
      "name": "entity.other.attribute-name.nunjucks"
    },
    "handlebars_attribute_value": {
      "begin": "([-a-zA-Z0-9_\\./]+)\\b",
      "captures": {
        "1": {
          "name": "variable.parameter.nunjucks"
        }
      },
      "end": "('|\"|)",
      "name": "entity.other.attribute-value.nunjucks",
      "patterns": [
        {
          "include": "#string"
        }
      ]
    },
    "handlebars_attribute": {
      "patterns": [
        {
          "include": "#handlebars_attribute_name"
        },
        {
          "include": "#handlebars_attribute_value"
        }
      ]
    },
    "extends": {
      "patterns": [
        {
          "end": "(\\}\\})",
          "begin": "(\\{\\{!<)\\s([-a-zA-Z0-9_\\./]+)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.nunjucks"
            },
            "2": {
              "name": "keyword.control.nunjucks"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.nunjucks"
            }
          },
          "name": "meta.tag.extends.nunjucks"
        }
      ]
    },
    "else_token": {
      "begin": "(\\{\\{)(~?else)(@?\\s(if)\\s([-a-zA-Z0-9_\\.\\(\\s\\)/]+))?",
      "end": "(~?\\}\\}\\}*)",
      "name": "meta.tag.inline.else.nunjucks",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.nunjucks"
        },
